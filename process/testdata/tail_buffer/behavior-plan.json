{
  "requirements": {
    "environment": {
      "go_experiments": [
        "jsonv2"
      ]
    }
  },
  "steps": [
    {
      "name": "native-tail-byte-conservation-and-ownership",
      "kind": "test",
      "arguments": [
        "./process",
        "-count=1",
        "-run=^(TestTailBufferConservesOrderedSuffixAcrossChunkBoundaries|TestTailBufferResetAndSnapshotHaveIndependentOwnership|TestTailBufferRefusesUnsetAndCorruptedCapabilities|TestTailBufferNumericOverflowIsAtomic|TestTailBufferObservationConservationLayerTriad|TestProductionStructDataFlowInventory|TestPublicOperationsAreOnlyTypedConstructionAndExecution|TestProductionImportsMatchTheExactDeclaredFrontier|TestProductionStructureForbidsWorldModelsAndWholeOutputPaths|TestProcessExternalIngressInventoryMatchesProduction)$"
      ]
    },
    {
      "name": "native-tail-partition-semantic-oracle",
      "kind": "fuzz",
      "arguments": [
        "./process"
      ],
      "fuzz_target": "FuzzTailBufferExternalIngress",
      "fuzz_seconds": 3
    }
  ]
}
