{
  "requirements": {
    "environment": {
      "go_experiments": [
        "jsonv2"
      ]
    }
  },
  "steps": [
    {
      "name": "native-window-fixed-space",
      "kind": "test",
      "arguments": [
        "./process",
        "-count=1",
        "-run=^TestTailBufferRetainsWindowInsteadOfSourceExtent$"
      ]
    },
    {
      "name": "retain-source",
      "kind": "mutate",
      "arguments": [
        "./process"
      ],
      "mutation": {
        "patch": "process/testdata/tail_buffer/retain_source.patch",
        "failing_test": "TestTailBufferRetainsWindowInsteadOfSourceExtent/8388608"
      }
    }
  ]
}
