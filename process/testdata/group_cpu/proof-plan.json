{
  "steps": [
    {
      "name": "native-group-cpu-and-memory-observation",
      "kind": "test",
      "arguments": [
        "./process",
        "-run=^(TestGroupCPUFoldLayerTriad|TestGroupCPUFoldStreamsGeneratedRows|FuzzGroupCPUNativeRows|TestObserveGroupCPUSeesBusyNativeGroup|TestGroupObservationRequestRefusesBeforeObservation|TestGroupMemoryFoldLayerTriad|TestGroupMemoryFoldStreamsGeneratedRows|FuzzGroupMemoryNativeRows|TestOwnedGroupProcessHelper|TestOwnedGroupNativeLayerTriad|TestOwnGroupRefusesSharedNativeGroup|TestProcessExternalIngressInventoryMatchesProduction|TestProductionStructDataFlowInventory|TestPublicOperationsAreOnlyTypedConstructionAndExecution|TestProductionImportsMatchTheExactDeclaredFrontier|TestProductionStructureForbidsWorldModelsAndWholeOutputPaths)$",
        "-race",
        "-count=1"
      ]
    },
    {
      "name": "ignore_decimal_tenth",
      "kind": "mutate",
      "arguments": ["./process"],
      "mutation": {
        "patch": "process/testdata/group_cpu/ignore_decimal_tenth.patch",
        "failing_test": "TestGroupCPUFoldLayerTriad"
      }
    },
    {
      "name": "sum_foreign_groups",
      "kind": "mutate",
      "arguments": ["./process"],
      "mutation": {
        "patch": "process/testdata/group_cpu/sum_foreign_groups.patch",
        "failing_test": "TestGroupCPUFoldLayerTriad"
      }
    },
    {
      "name": "accept_second_decimal",
      "kind": "mutate",
      "arguments": ["./process"],
      "mutation": {
        "patch": "process/testdata/group_cpu/accept_second_decimal.patch",
        "failing_test": "TestGroupCPUFoldLayerTriad"
      }
    },
    {
      "name": "native-cpu-row-oracle",
      "kind": "fuzz",
      "arguments": ["./process"],
      "fuzz_target": "FuzzGroupCPUNativeRows",
      "fuzz_seconds": 10
    },
    {
      "name": "process-vet",
      "kind": "vet",
      "arguments": ["./process"]
    }
  ]
}
