diff --git a/temporal/duration.go b/temporal/duration.go
index 67df895..08e5c4f 100644
--- a/temporal/duration.go
+++ b/temporal/duration.go
@@ -149,6 +149,29 @@ func (d Duration) Compare(other Duration) (core.Comparison, error) {
 	return compareInt64(d.nanoseconds, other.nanoseconds), nil
 }
 
+// Truncate projects d onto a compiler-owned precision through Go's duration
+// semantics. Zero remains a valid duration; invalid precision is refused.
+func (d Duration) Truncate(precision Precision) (Duration, error) {
+	value, err := d.Stdlib()
+	if err != nil {
+		return Duration{}, err
+	}
+	unit, err := precision.nanoseconds()
+	if err != nil {
+		return Duration{}, err
+	}
+	return NewDuration(value.Truncate(time.Duration(unit)))
+}
+
+// Text emits Go's exact duration representation after admission.
+func (d Duration) Text() (string, error) {
+	value, err := d.Stdlib()
+	if err != nil {
+		return "", err
+	}
+	return value.String(), nil
+}
+
 // Aggregate widens d without loss.
 func (d Duration) Aggregate() (AggregateDuration, error) {
 	return AggregateDurationFromDuration(d)
