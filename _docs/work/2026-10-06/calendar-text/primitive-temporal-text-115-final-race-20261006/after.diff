+func TestNativeTimeFormattingPreservesCalendarExtentAndLocation(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name  string
+		value time.Time
+	}{
+		{name: "Go zero timestamp", value: time.Time{}},
+		{name: "year 1000", value: time.Date(1000, time.January, 1, 0, 0, 0, 0, time.UTC)},
+		{name: "year 9999", value: time.Date(9999, time.December, 31, 23, 59, 59, 0, time.UTC)},
+		{name: "native explicit offset", value: time.Unix(0, 0).In(time.FixedZone("test", 3600))},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := temporal.FormatNativeTime(temporal.NativeTimeFormatRequest{Time: tc.value, Layout: time.RFC3339Nano})
+			if want := tc.value.Format(time.RFC3339Nano); err != nil || got != want {
+				t.Fatalf("native text = (%q, %v), want (%q, nil)", got, err, want)
+			}
+		})
+	}
+}
