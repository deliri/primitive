@@ -101,7 +114,8 @@ func applySecretHeaders(request *http.Request, headers []SecretHeader) {
 		case SecretHeaderBearer:
 			request.Header.Set(header.Name.String(), BearerAuthorizationScheme+" "+string(header.Value))
