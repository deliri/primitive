    {"name":"root-close-is-required", "kind":"mutate", "arguments":["./filestore"], "mutation":{"patch":"filestore/testdata/native-handles-skip-root-close.patch", "failing_test":"TestNativeRootHandleLayerTriad"}},
    {"name":"file-sync-is-required", "kind":"mutate", "arguments":["./filestore"], "mutation":{"patch":"filestore/testdata/native-handles-skip-file-sync.patch", "failing_test":"TestNativeFileHandleLayerTriad"}},
    {"name":"native-file-custody-fuzz", "kind":"fuzz", "arguments":["./filestore"], "fuzz_target":"FuzzNativeFileHandleCustody", "fuzz_seconds":1}
