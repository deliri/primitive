{
  "requirements": {
    "environment": {
      "go_experiments": [
        "jsonv2"
      ]
    },
    "job": {
      "cpu": 2,
      "memory_bytes": 4294967296,
      "scratch_bytes": 4294967296
    }
  },
  "steps": [
    {
      "name": "native-tar-read-contracts",
      "kind": "test",
      "arguments": [
        "./filestore",
        "-count=1",
        "-run=^(TestReadTARPreservesNativeEntriesAcrossWindows|TestReadTARRefusesBrokenNativeGZIPClosure|TestReadTARStopsAtConsumerRefusalAndCancellation|TestReadTARLoansBeforeFutureBytesWithFixedRetention|TestReadTARRefusesInvalidRequestBeforeSource|TestFilestorePublicIngressHasCompilerBoundSemanticProof)$"
      ]
    },
    {
      "name": "native-tar-read-semantic-fuzz",
      "kind": "fuzz",
      "arguments": [
        "./filestore"
      ],
      "fuzz_target": "FuzzReadTARMatchesNativeFramingAndClosure",
      "fuzz_seconds": 3
    }
  ]
}
