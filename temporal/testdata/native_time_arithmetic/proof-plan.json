{
  "requirements": {
    "environment": {
      "go_experiments": [
        "jsonv2"
      ]
    }
  },
  "steps": [
    {
      "name": "native-time-full-calendar-signed-arithmetic",
      "kind": "test",
      "arguments": [
        "./temporal",
        "-count=1",
        "-run=^(TestNativeTimeDifferencePreservesSignedSaturationAndMonotonicReadings|TestNativeTimeShiftPreservesSignedOffsetsLocationAndCalendarRange|TestTemporalProductionStructsHaveCompilerVisibleDataFlowRoles|TestTemporalPublicSurfaceMatchesReviewedContract|TestTemporalProductionStaysOnGoContextAndTimePrimitives)$"
      ]
    },
    {
      "name": "reverse-signed-difference",
      "kind": "mutate",
      "arguments": [
        "./temporal"
      ],
      "mutation": {
        "patch": "temporal/testdata/native_time_arithmetic/reverse_signed_difference.patch",
        "failing_test": "TestNativeTimeDifferencePreservesSignedSaturationAndMonotonicReadings"
      }
    },
    {
      "name": "narrow-difference-to-unix-nanoseconds",
      "kind": "mutate",
      "arguments": [
        "./temporal"
      ],
      "mutation": {
        "patch": "temporal/testdata/native_time_arithmetic/narrow_difference_to_unix_nanoseconds.patch",
        "failing_test": "TestNativeTimeDifferencePreservesSignedSaturationAndMonotonicReadings"
      }
    },
    {
      "name": "reverse-signed-offset",
      "kind": "mutate",
      "arguments": [
        "./temporal"
      ],
      "mutation": {
        "patch": "temporal/testdata/native_time_arithmetic/reverse_signed_offset.patch",
        "failing_test": "TestNativeTimeShiftPreservesSignedOffsetsLocationAndCalendarRange"
      }
    },
    {
      "name": "erase-native-carrier-location",
      "kind": "mutate",
      "arguments": [
        "./temporal"
      ],
      "mutation": {
        "patch": "temporal/testdata/native_time_arithmetic/erase_native_carrier_location.patch",
        "failing_test": "TestNativeTimeShiftPreservesSignedOffsetsLocationAndCalendarRange"
      }
    },
    {
      "name": "native-time-calendar-and-saturation-oracle",
      "kind": "fuzz",
      "arguments": [
        "./temporal"
      ],
      "fuzz_target": "FuzzNativeTimeArithmeticMatchesGoCalendarAndSaturation",
      "fuzz_seconds": 3
    }
  ]
}
