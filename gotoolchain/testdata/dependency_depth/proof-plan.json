{
  "requirements": {
    "environment": {
      "go_experiments": [
        "jsonv2"
      ]
    },
    "job": {
      "cpu": 2,
      "memory_bytes": 4294967296,
      "scratch_bytes": 4294967296
    }
  },
  "steps": [
    {
      "name": "native-dependency-depth-and-refusal-contracts",
      "kind": "test",
      "arguments": [
        "./gotoolchain",
        "-count=1",
        "-run=^(TestDependencyDepthReadsActualNativeClosure|TestDependencyDepthRefusesUnownedAndIncompleteFacts|TestDependencyDepthMissingNativeEdgesCannotBecomeClean|TestDependencyDepthObservationRequiresOwnedShape|TestGoToolchainProductionStructsHaveCompilerVisibleDataFlowRoles)$"
      ]
    },
    {
      "name": "native-dependency-depth-semantic-fuzz",
      "kind": "fuzz",
      "arguments": [
        "./gotoolchain"
      ],
      "fuzz_target": "FuzzDependencyDepthNativeGraphConservation",
      "fuzz_seconds": 3
    }
  ]
}
