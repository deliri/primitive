    },
    {
      "name": "module-trailing-document-is-admitted",
      "kind": "mutate",
      "arguments": [
        "./gotoolchain"
      ],
      "mutation": {
        "patch": "gotoolchain/testdata/module_file/module-trailing-document-is-admitted.patch",
        "failing_test": "TestModuleFileProjectionRefusesMalformedNativeRecords/trailing_document_refuses"
