        "failing_test": "TestObserveModuleFileUsesNativeGoWithoutEditingOrResolvingDependencies/pinned_release"
      }
    },
    {
      "name": "module-version-is-fabricated",
      "kind": "mutate",
      "arguments": [
        "./gotoolchain"
      ],
      "mutation": {
        "patch": "gotoolchain/testdata/module_file/module-version-is-fabricated.patch",
        "failing_test": "TestObserveModuleFileUsesNativeGoWithoutEditingOrResolvingDependencies/language_version"
      }
    },
    {
      "name": "module-absence-becomes-presence",
      "kind": "mutate",
      "arguments": [
        "./gotoolchain"
      ],
      "mutation": {
        "patch": "gotoolchain/testdata/module_file/module-absence-becomes-presence.patch",
        "failing_test": "TestObserveModuleFileUsesNativeGoWithoutEditingOrResolvingDependencies/absent_Go_directive"
      }
    },
    {
      "name": "module-replacement-count-is-truncated",
      "kind": "mutate",
      "arguments": [
        "./gotoolchain"
      ],
      "mutation": {
        "patch": "gotoolchain/testdata/module_file/module-replacement-count-is-truncated.patch",
        "failing_test": "TestObserveModuleFileUsesNativeGoWithoutEditingOrResolvingDependencies/replacement_block_counts_actual_entries"
      }
    },
    {
