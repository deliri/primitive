        "./gotoolchain"
      ],
      "mutation": {
        "patch": "gotoolchain/testdata/module_file/module-source-cause-is-lost.patch",
        "failing_test": "TestModuleFileProjectionPreservesSourceRefusalsAtEveryBoundary/3"
      }
    },
    {
      "name": "module-native-command-refusal-becomes-absence",
      "kind": "mutate",
